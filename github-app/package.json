    "@barry-rocks/logger": "link:../../../barry/packages/logger",
    "@barry-rocks/secrets": "link:../../../barry/packages/secrets",
    "express": "4.22.1"
  },
  "devDependencies": {
    "@types/express": "4.17.21",
    "@types/node": "22.15.0",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vitest": "4.1.0"
  },
  "private": true
