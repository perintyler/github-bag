  "license": "SEE LICENSE IN LICENSE.md",
  "description": "Barry's GitHub App bag - answers @barry mentions on issues and pull requests",
  "type": "module",
  "scripts": {
    "dev": "tsx --watch server/src/index.ts",
    "start": "tsx server/src/index.ts",
